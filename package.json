{
  "name": "@skydrivehq/brand-kit",
  "version": "0.3.0",
  "description": "The customer brand-kit drop-in engine shared by Stratica products. A customer drops in their own brand kit (logos, colours, a heading font, their brand guide); the product stores it in its own database and applies it to the screens, emails and documents its customers see.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyDriveHQ/brand-kit.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "default": "./dist/supabase/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./fonts/fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*",
    "./sql/brand_kit.sql": "./sql/brand_kit.sql"
  },
  "files": [
    "dist",
    "fonts",
    "src",
    "sql",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/make-fonts-css.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.6"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "brand-kit-css": "./dist/node/cli.js"
  }
}
